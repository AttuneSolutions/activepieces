{
  "name": "@attunesolutions/piece-echoback",
  "version": "0.0.2",
  "description": "Activepieces piece for the self-hosted echoback transcription service.",
  "license": "MIT",
  "homepage": "https://github.com/AttuneSolutions/echoback",
  "repository": {
    "type": "git",
