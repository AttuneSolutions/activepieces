{
  "name": "@attunesolutions/piece-yoke",
  "version": "0.2.2",
  "description": "Activepieces piece for Yoke — read instruction documents and gate flows on human approval.",
  "license": "MIT",
  "homepage": "https://www.yokecontrol.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AttuneSolutions/activepieces.git",
    "directory": "packages/pieces/community/yoke"
  },
  "keywords": [
    "activepieces",
    "activepieces-piece",
    "yoke",
    "approval",
    "human-in-the-loop"
  ],
  "type": "commonjs",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "dependencies": {
    "@activepieces/pieces-common": "workspace:*",
    "@activepieces/pieces-framework": "workspace:*"
  },
  "devDependencies": {
    "tslib": "2.6.2",
    "vitest": "3.2.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json && cp package.json dist/",
    "bundle": "node ../../../../dist/packages/cli/src/index.js pieces bundle",
    "lint": "eslint 'src/**/*.ts'",
    "test": "vitest run"
  }
}
